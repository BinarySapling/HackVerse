# Server
PORT=5000
NODE_ENV=development
TRUST_PROXY=1

# MongoDB (use Atlas URI in production)
MONGO_URI=mongodb://127.0.0.1:27017/HacVerse

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS - comma separated frontend origins (Vercel URL in production)
ALLOWED_ORIGINS=http://localhost:3000

# Frontend URL used in invitation emails
FRONTEND_URL=http://localhost:3000

# SMTP (optional — emails skipped if incomplete)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=HackVerse
MAIL_FROM_EMAIL=

# Local testing helper (optional)
DISABLE_LIMITER=true
