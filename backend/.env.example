# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=

# Security
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Email SMTP Settings
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=HackVerse
MAIL_FROM_EMAIL=
