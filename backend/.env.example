# =============================================================================
# HackVerse Backend — copy to .env and fill in values (never commit .env)
# =============================================================================

# --- Server ---
PORT=5000
# Use "production" in deployed environments (enables Secure cookies, JSON logs)
NODE_ENV=development
# Set to 1 behind reverse proxies (Render, Railway, Azure Container Apps)
TRUST_PROXY=1

# --- MongoDB (required) ---
# Local: mongodb://127.0.0.1:27017/hackverse
# Production: MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/hackverse

# --- JWT (required — use long random strings in production, not these placeholders) ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS & frontend (required in production) ---
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://hackverse.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Base URL for links in invitation / notification emails
FRONTEND_URL=http://localhost:3000

# --- Cookies (no env var — controlled by NODE_ENV) ---
# NODE_ENV=production → Secure=true, SameSite=none (required for cross-origin refresh cookies over HTTPS)
# NODE_ENV=development → Secure=false, SameSite=lax (works over HTTP on localhost)

# --- Upstash Redis (required for signup OTP) ---
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
OTP_TTL_SECONDS=180
OTP_RESEND_COOLDOWN_SECONDS=180
OTP_MAX_ATTEMPTS=5

# --- SMTP (optional — transactional emails skipped if host/user/pass are empty) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=HackVerse
MAIL_FROM_EMAIL=

# --- Local dev helpers (do NOT set in production) ---
# DISABLE_LIMITER=true
